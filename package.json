{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "mkdir -p public/uploads && (cp -r data/uploads/* public/uploads/ 2>/dev/null || true) && (tsx scripts/generate-favicons.ts || true) && (tsx scripts/sync-catalog.ts || true) && (tsx scripts/generate-sitemap.ts || true) && vite build && mkdir -p dist/uploads && (cp -r public/uploads/* dist/uploads/ 2>/dev/null || true) && (cp -r data/uploads/* dist/uploads/ 2>/dev/null || true) && (esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs || true)",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "fetch-cf-analytics": "tsx scripts/fetch-cloudflare-analytics.ts",
    "enrich-d1-products": "tsx scripts/enrich-products-d1-gemini.ts",
    "fetch-products": "tsx scripts/fetch-products.ts",
    "sync-d1-to-local": "tsx scripts/sync-d1-to-local.ts",
    "delete-products-list": "tsx scripts/delete-products-list.ts",
    "push-local-to-d1": "tsx scripts/push-local-to-d1-api.ts",
    "delete-no-image-products": "tsx scripts/delete-no-image-products.ts",
    "migrate-d1-to-r2": "tsx migrate-d1-to-r2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@google/genai": "^1.0.0",
    "@paypal/react-paypal-js": "^8.7.0",
    "@react-oauth/google": "^0.12.1",
    "@tailwindcss/vite": "^4.0.0",
    "@upstash/redis": "^1.34.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "worker-mailer": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^4.0.0"
  }
}