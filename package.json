{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "mkdir -p public/uploads && (cp -r data/uploads/. public/uploads/ 2>/dev/null || true) && tsx scripts/generate-favicons.ts && tsx scripts/sync-catalog.ts && tsx scripts/generate-sitemap.ts && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "fetch-cf-analytics": "tsx scripts/fetch-cloudflare-analytics.ts",
    "enrich-d1-products": "tsx scripts/enrich-products-d1-gemini.ts",
    "fetch-products": "tsx scripts/fetch-products.ts",
    "sync-d1-to-local": "tsx scripts/sync-d1-to-local.ts",
    "delete-products-list": "tsx scripts/delete-products-list.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@paypal/react-paypal-js": "^10.4.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@upstash/redis": "^1.38.4",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "worker-mailer": "^1.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  }
}
