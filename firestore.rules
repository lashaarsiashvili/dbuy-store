rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /store/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /orders/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /store_uploads/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
