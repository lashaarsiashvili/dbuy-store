rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /billboards/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
